# Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Optional: path to YouTube cookies.txt (Netscape format)
# Required on cloud servers (Render, etc) to bypass YouTube bot detection.
# If not set, bot looks for cookies.txt in project root.
# YOUTUBE_COOKIES_PATH=./cookies.txt
# Alternatively, paste raw cookie content into environment variable:
# YOUTUBE_COOKIES_CONTENT="paste_cookies_txt_content_here"
